<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rushdul Hidayah - Blog & Admin Management</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts Inter & Playfair Display -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Playfair Display', 'serif']
                    },
                    colors: {
                        emerald: {
                            600: '#059669',
                            700: '#047857',
                            800: '#065f46',
                            900: '#064e3b'
                        },
                        amber: {
                            600: '#d97706',
                            700: '#b45309'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .heading-serif { font-family: 'Playfair Display', serif; }
        .transition-all { transition: all 0.3s ease; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 min-h-screen flex flex-col">

    <!-- Notification Toast -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-emerald-800 text-white px-6 py-3 rounded-xl shadow-2xl flex items-center space-x-3">
        <i id="toast-icon" class="fa-solid fa-check-circle text-amber-400 text-lg"></i>
        <span id="toast-msg" class="font-medium text-sm">Action completed successfully!</span>
    </div>

    <!-- Navigation Header -->
    <header class="bg-emerald-900 text-white shadow-md sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="bg-emerald-800 p-2 rounded-xl border border-emerald-700 shadow-inner">
                    <i class="fa-solid fa-book-quran text-amber-400 text-2xl"></i>
                </div>
                <div>
                    <span class="text-xl font-bold font-serif tracking-wide block">Rushdul Hidayah</span>
                    <span class="text-xs text-emerald-300 tracking-wider uppercase font-medium">Guidance & Knowledge Portal</span>
                </div>
            </div>
            
            <div class="flex items-center space-x-3">
                <button onclick="switchView('public')" id="nav-public-btn" class="px-4 py-2 rounded-xl text-sm font-medium bg-emerald-800 text-amber-300 shadow transition-all flex items-center space-x-2">
                    <i class="fa-solid fa-globe"></i>
                    <span>Live Blog View</span>
                </button>
                <button onclick="switchView('admin')" id="nav-admin-btn" class="px-4 py-2 rounded-xl text-sm font-medium bg-emerald-950 text-emerald-200 hover:bg-emerald-800 transition-all flex items-center space-x-2 border border-emerald-700/50">
                    <i class="fa-solid fa-user-shield text-amber-400"></i>
                    <span>Admin Dashboard</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <!-- ================= PUBLIC BLOG VIEW ================= -->
        <div id="view-public" class="space-y-8">
            <!-- Hero Banner -->
            <div class="bg-gradient-to-r from-emerald-800 to-emerald-950 rounded-3xl p-8 sm:p-12 text-white shadow-xl relative overflow-hidden border border-emerald-700/30">
                <div class="absolute -right-10 -bottom-10 opacity-10 text-emerald-400">
                    <i class="fa-solid fa-mosque text-9xl"></i>
                </div>
                <div class="max-w-3xl relative z-10">
                    <span class="bg-amber-400/20 text-amber-300 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-widest border border-amber-400/30 mb-4 inline-block">Authentic Knowledge & Articles</span>
                    <h1 class="text-3xl sm:text-5xl font-bold font-serif mb-4 leading-tight">Illuminating Hearts Through Sacred Guidance</h1>
                    <p class="text-emerald-100 text-base sm:text-lg font-light leading-relaxed">Explore insightful articles, reflections, and reminders curated with care from Rushdul Hidayah.</p>
                </div>
            </div>

            <!-- Search & Filter Bar -->
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 bg-white p-4 rounded-2xl shadow-sm border border-gray-100">
                <div class="relative w-full sm:w-96">
                    <i class="fa-solid fa-search absolute left-4 top-3.5 text-gray-400 text-sm"></i>
                    <input type="text" id="public-search" oninput="filterBlogs()" placeholder="Search articles or topics..." class="w-full pl-11 pr-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent text-sm">
                </div>
                <div class="text-sm text-gray-500 font-medium px-2">
                    Showing <span id="article-count" class="text-emerald-700 font-bold">0</span> Published Articles
                </div>
            </div>

            <!-- Blog Articles Grid -->
            <div id="blog-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Dynamically populated blog cards -->
            </div>

            <!-- Full Article Reading Modal -->
            <div id="article-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4">
                <div class="bg-white w-full max-w-4xl max-h-[90vh] rounded-3xl shadow-2xl overflow-y-auto flex flex-col animate-in fade-in zoom-in duration-200">
                    <div class="sticky top-0 bg-white/90 backdrop-blur border-b border-gray-100 px-6 py-4 flex items-center justify-between z-10">
                        <div class="flex items-center space-x-2 text-xs font-semibold text-emerald-700 uppercase tracking-wider">
                            <i class="fa-solid fa-bookmark"></i>
                            <span id="modal-category">Islamic Guidance</span>
                        </div>
                        <button onclick="closeArticleModal()" class="w-9 h-9 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-600 flex items-center justify-center transition-all">
                            <i class="fa-solid fa-xmark text-lg"></i>
                        </button>
                    </div>
                    <div id="modal-content" class="p-6 sm:p-10 space-y-6">
                        <!-- Populated by JS -->
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= ADMIN DASHBOARD VIEW ================= -->
        <div id="view-admin" class="space-y-8 hidden">
            <!-- Admin Top Bar -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-6 rounded-3xl shadow-sm border border-gray-100">
                <div>
                    <h2 class="text-2xl font-bold font-serif text-gray-900">Admin Content Management</h2>
                    <p class="text-sm text-gray-500 mt-1">Add, edit, and organize SEO-compliant blog posts with structured headings (H1, H2, H3).</p>
                </div>
                <button onclick="openPostEditor()" class="bg-emerald-700 hover:bg-emerald-800 text-white px-5 py-3 rounded-2xl font-semibold shadow-lg shadow-emerald-700/20 transition-all flex items-center space-x-2 text-sm self-start sm:self-auto">
                    <i class="fa-solid fa-plus-circle text-amber-300"></i>
                    <span>Create New Post</span>
                </button>
            </div>

            <!-- Admin Posts Table -->
            <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
                    <span class="font-semibold text-gray-700 text-sm">All Blog Posts (<span id="admin-post-count">0</span>)</span>
                    <span class="text-xs text-gray-400">SEO Rules & Structured Markup Enabled</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-gray-100 text-xs font-semibold text-gray-400 uppercase tracking-wider bg-gray-50/30">
                                <th class="py-4 px-6">Post Title & URL Slug</th>
                                <th class="py-4 px-6">Category</th>
                                <th class="py-4 px-6">SEO Score</th>
                                <th class="py-4 px-6">Date Added</th>
                                <th class="py-4 px-6 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="admin-posts-table" class="divide-y divide-gray-100 text-sm">
                            <!-- Populated by JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ================= POST CREATION / EDITING MODAL ================= -->
        <div id="post-editor-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4">
            <div class="bg-white w-full max-w-4xl max-h-[92vh] rounded-3xl shadow-2xl overflow-y-auto flex flex-col animate-in fade-in zoom-in duration-200">
                <div class="sticky top-0 bg-white/95 backdrop-blur border-b border-gray-100 px-6 py-4 flex items-center justify-between z-20">
                    <h3 id="editor-modal-title" class="text-lg font-bold text-gray-900 font-serif">Create / Edit Blog Post</h3>
                    <button onclick="closePostEditor()" class="w-9 h-9 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-600 flex items-center justify-center transition-all">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>
                
                <form id="blog-form" onsubmit="saveBlogPost(event)" class="p-6 sm:p-8 space-y-6">
                    <input type="hidden" id="post-id">

                    <!-- Basic Info Section -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-2">Post Title (Main H1 Heading)</label>
                            <input type="text" id="post-title" required oninput="generateSlug()" placeholder="e.g., The Importance of Seeking Knowledge in Islam" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-emerald-600 text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-2">URL Slug (SEO Friendly)</label>
                            <input type="text" id="post-slug" required placeholder="importance-seeking-knowledge" class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-emerald-600 text-sm font-mono text-xs">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-2">Category</label>
                            <select id="post-category" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-emerald-600 text-sm bg-white">
                                <option value="Islamic Guidance">Islamic Guidance</option>
                                <option value="Quran & Sunnah">Quran & Sunnah</option>
                                <option value="Spiritual Reflections">Spiritual Reflections</option>
                                <option value="Community & Events">Community & Events</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-2">Featured Image URL</label>
                            <input type="url" id="post-image" required placeholder="https://images.unsplash.com/..." class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-emerald-600 text-sm">
                        </div>
                    </div>

                    <!-- SEO Section Card -->
                    <div class="bg-emerald-50/50 p-6 rounded-2xl border border-emerald-100 space-y-4">
                        <div class="flex items-center space-x-2 text-emerald-800 font-semibold text-sm">
                            <i class="fa-solid fa-chart-line text-amber-600"></i>
                            <span>SEO Optimization Settings</span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">SEO Meta Title (50-60 chars)</label>
                                <input type="text" id="post-meta-title" placeholder="Title displayed on Google search results" class="w-full px-3 py-2.5 rounded-xl border border-gray-200 bg-white text-sm">
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">SEO Meta Description (120-160 chars)</label>
                                <textarea id="post-meta-desc" rows="2" placeholder="Brief summary for search engine results..." class="w-full px-3 py-2 rounded-xl border border-gray-200 bg-white text-sm resize-none"></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Content Structured Builder (H1, H2, H3, Paragraphs, Images) -->
                    <div class="space-y-4">
                        <div class="flex items-center justify-between">
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-gray-600">Structured Content Blocks (H1, H2, H3, Paragraphs)</label>
                                <p class="text-xs text-gray-400">Build your blog post using structured subheadings for optimal readability & SEO.</p>
                            </div>
                            <div class="flex items-center space-x-2">
                                <button type="button" onclick="addContentBlock('h2')" class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-xs font-semibold transition-all">+ Add H2</button>
                                <button type="button" onclick="addContentBlock('h3')" class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-xs font-semibold transition-all">+ Add H3</button>
                                <button type="button" onclick="addContentBlock('p')" class="px-3 py-1.5 bg-emerald-100 hover:bg-emerald-200 text-emerald-800 rounded-lg text-xs font-semibold transition-all">+ Add Paragraph</button>
                            </div>
                        </div>

                        <div id="content-blocks-container" class="space-y-3 max-h-80 overflow-y-auto p-2 border border-gray-100 rounded-2xl bg-gray-50/50">
                            <!-- Dynamic content blocks added here -->
                        </div>
                    </div>

                    <!-- Submit Actions -->
                    <div class="flex items-center justify-end space-x-3 pt-4 border-t border-gray-100">
                        <button type="button" onclick="closePostEditor()" class="px-5 py-2.5 rounded-xl text-sm font-semibold text-gray-600 hover:bg-gray-100 transition-all">Cancel</button>
                        <button type="submit" class="px-6 py-2.5 rounded-xl text-sm font-semibold bg-emerald-700 hover:bg-emerald-800 text-white shadow-lg shadow-emerald-700/20 transition-all">Save & Publish Post</button>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-100 py-8 mt-12 text-center text-xs text-gray-400">
        <p>&copy; 2026 Rushdul Hidayah. All rights reserved. Built with SEO & Admin Management.</p>
    </footer>

    <!-- Application Script -->
    <script>
        // Initial Mock Database for Rushdul Hidayah Blog
        let blogPosts = [
            {
                id: '1',
                title: 'The Virtues of Seeking Knowledge in the Light of Quran & Sunnah',
                slug: 'virtues-of-seeking-knowledge',
                category: 'Islamic Guidance',
                image: 'https://images.unsplash.com/photo-1584551246679-0daf3d275d0f?auto=format&fit=crop&w=800&q=80',
                metaTitle: 'The Virtues of Seeking Knowledge in Islam | Rushdul Hidayah',
                metaDescription: 'Discover the profound importance and spiritual rewards of pursuing sacred knowledge according to authentic Islamic teachings.',
                date: 'May 14, 2026',
                blocks: [
                    { type: 'h2', text: 'The Journey of Knowledge in Islam' },
                    { type: 'p', text: 'Seeking knowledge is an obligatory duty upon every Muslim. The Quran constantly elevates those who possess wisdom and knowledge, encouraging believers to pray for an increase in understanding.' },
                    { type: 'h3', text: 'Rewards Mentioned in Hadith' },
                    { type: 'p', text: 'The Messenger of Allah (peace be upon him) stated that whoever takes a path upon which to seek knowledge, Allah makes easy for them a path to Paradise.' }
                ]
            },
            {
                id: '2',
                title: 'Finding Inner Peace Through Daily Dhikr and Gratitude',
                slug: 'finding-inner-peace-through-dhikr',
                category: 'Spiritual Reflections',
                image: 'https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=800&q=80',
                metaTitle: 'Finding Inner Peace Through Dhikr & Gratitude | Rushdul Hidayah',
                metaDescription: 'Learn how regular remembrance of Allah (Dhikr) and practicing gratitude (Shukr) transform the heart and bring true tranquility.',
                date: 'May 10, 2026',
                blocks: [
                    { type: 'h2', text: 'Tranquility of the Heart' },
                    { type: 'p', text: 'In a fast-paced world filled with anxiety, the remembrance of Allah serves as an anchor for the soul, bringing unmatched stability and peace.' },
                    { type: 'h3', text: 'Practicing Daily Shukr' },
                    { type: 'p', text: 'Gratitude multiplies blessings. When we consciously recognize the countless favors bestowed upon us, complaining fades and contentment takes root.' }
                ]
            }
        ];

        // Switch between Public Blog View and Admin Dashboard
        function switchView(view) {
            const publicView = document.getElementById('view-public');
            const adminView = document.getElementById('view-admin');
            const publicBtn = document.getElementById('nav-public-btn');
            const adminBtn = document.getElementById('nav-admin-btn');

            if (view === 'public') {
                publicView.classList.remove('hidden');
                adminView.classList.add('hidden');
                publicBtn.className = "px-4 py-2 rounded-xl text-sm font-medium bg-emerald-800 text-amber-300 shadow transition-all flex items-center space-x-2";
                adminBtn.className = "px-4 py-2 rounded-xl text-sm font-medium bg-emerald-950 text-emerald-200 hover:bg-emerald-800 transition-all flex items-center space-x-2 border border-emerald-700/50";
                renderPublicBlogs();
            } else {
                publicView.classList.add('hidden');
                adminView.classList.remove('hidden');
                adminBtn.className = "px-4 py-2 rounded-xl text-sm font-medium bg-emerald-800 text-amber-300 shadow transition-all flex items-center space-x-2";
                publicBtn.className = "px-4 py-2 rounded-xl text-sm font-medium bg-emerald-950 text-emerald-200 hover:bg-emerald-800 transition-all flex items-center space-x-2 border border-emerald-700/50";
                renderAdminTable();
            }
        }

        // Show Toast Notification
        function showToast(message, isError = false) {
            const toast = document.getElementById('toast');
            const msgEl = document.getElementById('toast-msg');
            const iconEl = document.getElementById('toast-icon');

            msgEl.textContent = message;
            iconEl.className = isError ? "fa-solid fa-triangle-exclamation text-amber-400 text-lg" : "fa-solid fa-check-circle text-amber-400 text-lg";
            
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        // Render Public Blog Grid
        function renderPublicBlogs(filterQuery = '') {
            const grid = document.getElementById('blog-grid');
            const countEl = document.getElementById('article-count');
            
            const filtered = blogPosts.filter(post => 
                post.title.toLowerCase().includes(filterQuery.toLowerCase()) ||
                post.category.toLowerCase().includes(filterQuery.toLowerCase())
            );

            countEl.textContent = filtered.length;

            if (filtered.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full py-16 text-center bg-white rounded-3xl border border-gray-100">
                        <i class="fa-solid fa-folder-open text-4xl text-gray-300 mb-3"></i>
                        <p class="text-gray-500 font-medium text-sm">No articles found matching your search.</p>
                    </div>
                `;
                return;
            }

            grid.innerHTML = filtered.map(post => `
                <article onclick="openArticleModal('${post.id}')" class="bg-white rounded-3xl shadow-sm hover:shadow-xl transition-all border border-gray-100 overflow-hidden cursor-pointer flex flex-col group">
                    <div class="relative h-52 overflow-hidden bg-gray-100">
                        <img src="${post.image}" alt="${post.title}" class="w-full h-full object-cover group-hover:scale-105 transition-all duration-500" onerror="this.src='https://placehold.co/600x400/064e3b/ffffff?text=Rushdul+Hidayah'">
                        <div class="absolute top-4 left-4 bg-emerald-900/90 backdrop-blur text-amber-300 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider border border-emerald-700/50">
                            ${post.category}
                        </div>
                    </div>
                    <div class="p-6 flex flex-col flex-grow justify-between space-y-4">
                        <div>
                            <span class="text-xs text-gray-400 font-medium block mb-2"><i class="fa-regular fa-calendar mr-1"></i> ${post.date}</span>
                            <h2 class="text-xl font-bold font-serif text-gray-900 group-hover:text-emerald-700 transition-colors line-clamp-2">${post.title}</h2>
                            <p class="text-sm text-gray-500 mt-2 line-clamp-2 font-light">${post.metaDescription || 'Read full article to gain insightful Islamic knowledge and spiritual reminders.'}</p>
                        </div>
                        <div class="flex items-center text-xs font-semibold text-emerald-700 group-hover:translate-x-1 transition-transform pt-2 border-t border-gray-50">
                            <span>Read Complete Article</span>
                            <i class="fa-solid fa-arrow-right ml-2 text-amber-600"></i>
                        </div>
                    </div>
                </article>
            `).join('');
        }

        function filterBlogs() {
            const query = document.getElementById('public-search').value;
            renderPublicBlogs(query);
        }

        // Open Full Article Modal
        function openArticleModal(id) {
            const post = blogPosts.find(p => p.id === id);
            if (!post) return;

            document.getElementById('modal-category').textContent = post.category;
            
            // Find related posts for the sticky sidebar
            const relatedPosts = blogPosts.filter(p => p.id !== id).slice(0, 3);
            let relatedHtml = relatedPosts.map(rel => `
                <div onclick="openArticleModal('${rel.id}')" class="flex space-x-3 cursor-pointer group p-2 hover:bg-gray-50 rounded-xl transition-all">
                    <img src="${rel.image}" alt="${rel.title}" class="w-16 h-16 rounded-xl object-cover flex-shrink-0" onerror="this.src='https://placehold.co/200x200/064e3b/ffffff?text=RH'">
                    <div>
                        <span class="text-[10px] text-emerald-700 font-semibold block">${rel.category}</span>
                        <h4 class="text-xs font-bold text-gray-800 group-hover:text-emerald-700 transition-colors line-clamp-2">${rel.title}</h4>
                    </div>
                </div>
            `).join('');

            let html = `
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    <!-- Main Article Content (2 Columns) -->
                    <div class="lg:col-span-2 space-y-6">
                        <div class="space-y-4">
                            <span class="text-xs text-gray-400 font-medium"><i class="fa-regular fa-calendar mr-1"></i> ${post.date} &bull; Slug: /${post.slug}</span>
                            <h1 class="text-3xl sm:text-4xl font-bold font-serif text-gray-900 leading-snug">${post.title}</h1>
                        </div>
                        <div class="rounded-2xl overflow-hidden h-72 sm:h-80 bg-gray-100 shadow-inner">
                            <img src="${post.image}" alt="${post.title}" class="w-full h-full object-cover">
                        </div>
                        <div class="space-y-6 pt-4 text-gray-700 leading-relaxed text-base sm:text-lg font-light">
            `;

            if (post.blocks && post.blocks.length > 0) {
                post.blocks.forEach(block => {
                    if (block.type === 'h2') {
                        html += `<h2 class="text-2xl font-bold font-serif text-emerald-900 mt-6 mb-3 border-l-4 border-amber-500 pl-4">${block.text}</h2>`;
                    } else if (block.type === 'h3') {
                        html += `<h3 class="text-xl font-semibold text-gray-800 mt-5 mb-2">${block.text}</h3>`;
                    } else if (block.type === 'p') {
                        html += `<p class="mb-4">${block.text}</p>`;
                    }
                });
            } else {
                html += `<p>${post.metaDescription}</p>`;
            }

            html += `
                        </div>

                        <!-- SEO Keywords & NLP Section Below Blog -->
                        <div class="mt-12 pt-8 border-t border-gray-100 space-y-6 bg-emerald-50/40 p-6 sm:p-8 rounded-3xl border border-emerald-100/60">
                            <div class="flex items-center space-x-2 text-emerald-900">
                                <i class="fa-solid fa-tags text-amber-600 text-lg"></i>
                                <h3 class="text-lg font-bold font-serif">SEO Keywords & NLP Content Analysis</h3>
                            </div>
                            <p class="text-xs text-gray-500">Optimized semantic keywords and latent semantic indexing (LSI) entities embedded in this article for top search engine positioning.</p>
                            
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100">
                                    <span class="text-[10px] font-bold uppercase tracking-wider text-amber-700 block mb-2">Short-Tail Keywords</span>
                                    <div class="flex flex-wrap gap-1.5">
                                        <span class="bg-gray-100 text-gray-700 px-2.5 py-1 rounded-lg text-xs font-medium">Knowledge</span>
                                        <span class="bg-gray-100 text-gray-700 px-2.5 py-1 rounded-lg text-xs font-medium">Islam</span>
                                        <span class="bg-gray-100 text-gray-700 px-2.5 py-1 rounded-lg text-xs font-medium">Guidance</span>
                                    </div>
                                </div>
                                <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100">
                                    <span class="text-[10px] font-bold uppercase tracking-wider text-amber-700 block mb-2">Long-Tail Keywords</span>
                                    <div class="flex flex-wrap gap-1.5">
                                        <span class="bg-gray-100 text-gray-700 px-2.5 py-1 rounded-lg text-xs font-medium">importance of seeking knowledge in Islam</span>
                                        <span class="bg-gray-100 text-gray-700 px-2.5 py-1 rounded-lg text-xs font-medium">finding inner peace through dhikr</span>
                                    </div>
                                </div>
                                <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100">
                                    <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-700 block mb-2">LSI Keywords</span>
                                    <div class="flex flex-wrap gap-1.5">
                                        <span class="bg-emerald-50 text-emerald-800 px-2.5 py-1 rounded-lg text-xs font-medium">Quranic verses</span>
                                        <span class="bg-emerald-50 text-emerald-800 px-2.5 py-1 rounded-lg text-xs font-medium">authentic Hadith</span>
                                        <span class="bg-emerald-50 text-emerald-800 px-2.5 py-1 rounded-lg text-xs font-medium">spiritual growth</span>
                                    </div>
                                </div>
                                <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100">
                                    <span class="text-[10px] font-bold uppercase tracking-wider text-blue-700 block mb-2">NLP Entities & Concepts</span>
                                    <div class="flex flex-wrap gap-1.5">
                                        <span class="bg-blue-50 text-blue-800 px-2.5 py-1 rounded-lg text-xs font-medium">Divine wisdom</span>
                                        <span class="bg-blue-50 text-blue-800 px-2.5 py-1 rounded-lg text-xs font-medium">Islamic jurisprudence</span>
                                        <span class="bg-blue-50 text-blue-800 px-2.5 py-1 rounded-lg text-xs font-medium">heart tranquility</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Sticky Sidebar (1 Column) -->
                    <div class="space-y-6">
                        <div class="sticky top-24 bg-gray-50/80 backdrop-blur p-6 rounded-3xl border border-gray-100 space-y-6 shadow-sm">
                            <div class="flex items-center space-x-2 text-emerald-900 border-b border-gray-200 pb-3">
                                <i class="fa-solid fa-compass text-amber-600"></i>
                                <h3 class="font-serif font-bold text-base">Related Articles</h3>
                            </div>
                            <div class="space-y-4">
                                ${relatedHtml || '<p class="text-xs text-gray-400">No other articles available at the moment.</p>'}
                            </div>

                            <div class="bg-emerald-900 text-white p-5 rounded-2xl space-y-3 relative overflow-hidden">
                                <div class="absolute -right-6 -bottom-6 opacity-10 text-amber-400">
                                    <i class="fa-solid fa-book-quran text-7xl"></i>
                                </div>
                                <h4 class="font-serif font-bold text-sm text-amber-300">Rushdul Hidayah Newsletter</h4>
                                <p class="text-xs text-emerald-100 font-light">Receive daily Islamic reminders and new articles directly in your inbox.</p>
                                <div class="pt-1">
                                    <input type="email" placeholder="Your email address" class="w-full px-3 py-2 text-xs rounded-xl text-gray-800 bg-white focus:outline-none mb-2">
                                    <button onclick="showToast('Subscribed successfully!')" class="w-full py-2 bg-amber-500 hover:bg-amber-600 text-emerald-950 font-bold rounded-xl text-xs transition-all shadow">Subscribe Now</button>
