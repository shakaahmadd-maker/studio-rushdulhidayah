            `;

            document.getElementById('modal-content').innerHTML = html;
            document.getElementById('article-modal').classList.remove('hidden');
            document.getElementById('article-modal').classList.add('flex');
        }

        function closeArticleModal() {
            document.getElementById('article-modal').classList.add('hidden');
            document.getElementById('article-modal').classList.remove('flex');
        }

        // Render Admin Posts Table
        function renderAdminTable() {
            const tbody = document.getElementById('admin-posts-table');
            document.getElementById('admin-post-count').textContent = blogPosts.length;

            if (blogPosts.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="py-8 text-center text-gray-400">No blog posts available. Create your first post!</td></tr>`;
                return;
            }

            tbody.innerHTML = blogPosts.map(post => `
                <tr class="hover:bg-gray-50/80 transition-colors">
                    <td class="py-4 px-6">
                        <div class="font-bold text-gray-900 line-clamp-1">${post.title}</div>
                        <div class="text-xs font-mono text-gray-400 mt-0.5">/${post.slug}</div>
                    </td>
                    <td class="py-4 px-6">
                        <span class="bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full text-xs font-semibold">${post.category}</span>
                    </td>
                    <td class="py-4 px-6">
                        <span class="inline-flex items-center text-xs font-bold text-emerald-600 bg-emerald-100/60 px-2.5 py-1 rounded-lg">
                            <i class="fa-solid fa-circle-check mr-1.5 text-emerald-600"></i> Optimized (SEO)
                        </span>
                    </td>
                    <td class="py-4 px-6 text-xs text-gray-500">${post.date}</td>
                    <td class="py-4 px-6 text-right space-x-2">
                        <button onclick="editBlogPost('${post.id}')" class="w-8 h-8 rounded-lg bg-gray-100 hover:bg-emerald-100 text-gray-600 hover:text-emerald-700 transition-all inline-flex items-center justify-center">
                            <i class="fa-solid fa-pen text-xs"></i>
                        </button>
                        <button onclick="deleteBlogPost('${post.id}')" class="w-8 h-8 rounded-lg bg-gray-100 hover:bg-red-100 text-gray-600 hover:text-red-600 transition-all inline-flex items-center justify-center">
                            <i class="fa-solid fa-trash text-xs"></i>
                        </button>
                    </td>
                </tr>
            `).join('');
        }

        // Open Post Editor (Create or Edit)
        function openPostEditor(id = null) {
            const modal = document.getElementById('post-editor-modal');
            const container = document.getElementById('content-blocks-container');
            document.getElementById('blog-form').reset();
            document.getElementById('post-id').value = '';
            container.innerHTML = '';

            if (id) {
                document.getElementById('editor-modal-title').textContent = 'Edit Blog Post & SEO Rules';
                const post = blogPosts.find(p => p.id === id);
                if (post) {
                    document.getElementById('post-id').value = post.id;
                    document.getElementById('post-title').value = post.title;
                    document.getElementById('post-slug').value = post.slug;
                    document.getElementById('post-category').value = post.category;
                    document.getElementById('post-image').value = post.image;
                    document.getElementById('post-meta-title').value = post.metaTitle || '';
                    document.getElementById('post-meta-desc').value = post.metaDescription || '';

                    if (post.blocks && post.blocks.length > 0) {
                        post.blocks.forEach(block => addContentBlock(block.type, block.text));
                    }
                }
            } else {
                document.getElementById('editor-modal-title').textContent = 'Create New Blog Post';
                // Add default starter blocks
                addContentBlock('h2', 'Introduction');
                addContentBlock('p', 'Write your introductory paragraph here...');
            }

            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closePostEditor() {
            document.getElementById('post-editor-modal').classList.add('hidden');
            document.getElementById('post-editor-modal').classList.remove('flex');
        }

        // Generate URL Slug Automatically from Title
        function generateSlug() {
            const title = document.getElementById('post-title').value;
            const slug = title.toLowerCase()
                .replace(/[^a-z0-9\s-]/g, '')
                .trim()
                .replace(/\s+/g, '-');
            document.getElementById('post-slug').value = slug;
        }

        // Add Content Block (H2, H3, Paragraph)
        function addContentBlock(type, text = '') {
            const container = document.getElementById('content-blocks-container');
            const div = document.createElement('div');
            div.className = "flex items-start space-x-3 bg-white p-3 rounded-xl border border-gray-200 shadow-sm content-block-item";
            
            let labelBadge = type === 'h2' ? '<span class="bg-amber-100 text-amber-800 px-2 py-1 rounded text-[10px] font-bold uppercase">H2 Subheading</span>' :
                             type === 'h3' ? '<span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-[10px] font-bold uppercase">H3 Subheading</span>' :
                             '<span class="bg-emerald-100 text-emerald-800 px-2 py-1 rounded text-[10px] font-bold uppercase">Paragraph</span>';

            div.innerHTML = `
                <div class="flex flex-col space-y-1 w-28 flex-shrink-0 pt-1">
                    ${labelBadge}
                </div>
                <textarea rows="${type === 'p' ? '3' : '1'}" data-type="${type}" placeholder="Enter ${type.toUpperCase()} content..." class="flex-grow px-3 py-2 text-sm rounded-lg border border-gray-200 focus:outline-none focus:ring-1 focus:ring-emerald-600 block-text-input resize-none">${text}</textarea>
                <button type="button" onclick="this.parentElement.remove()" class="text-gray-400 hover:text-red-600 p-2 transition-colors">
                    <i class="fa-solid fa-trash text-xs"></i>
                </button>
            `;
            container.appendChild(div);
        }

        // Save Blog Post
        function saveBlogPost(e) {
            e.preventDefault();
            const id = document.getElementById('post-id').value;
            const title = document.getElementById('post-title').value;
            const slug = document.getElementById('post-slug').value;
            const category = document.getElementById('post-category').value;
            const image = document.getElementById('post-image').value;
            const metaTitle = document.getElementById('post-meta-title').value;
            const metaDescription = document.getElementById('post-meta-desc').value;

            // Collect structured content blocks
            const blockElements = document.querySelectorAll('.content-block-item');
            const blocks = [];
            blockElements.forEach(el => {
                const textarea = el.querySelector('.block-text-input');
                if (textarea && textarea.value.trim() !== '') {
                    blocks.push({
                        type: textarea.getAttribute('data-type'),
                        text: textarea.value.trim()
                    });
                }
            });

            const currentDate = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

            if (id) {
                // Update existing post
                const index = blogPosts.findIndex(p => p.id === id);
                if (index !== -1) {
                    blogPosts[index] = { ...blogPosts[index], title, slug, category, image, metaTitle, metaDescription, blocks };
                }
                showToast('Blog post updated successfully!');
            } else {
                // Create new post
                const newPost = {
                    id: Date.now().toString(),
                    title,
                    slug,
                    category,
                    image,
                    metaTitle: metaTitle || title,
                    metaDescription: metaDescription || (blocks.find(b => b.type === 'p')?.text || title),
                    date: currentDate,
                    blocks
                };
                blogPosts.unshift(newPost);
                showToast('New blog post published successfully!');
            }

            closePostEditor();
            renderAdminTable();
            renderPublicBlogs();
        }

        function editBlogPost(id) {
            openPostEditor(id);
        }

        function deleteBlogPost(id) {
            if (confirm('Are you sure you want to delete this blog post?')) {
                blogPosts = blogPosts.filter(p => p.id !== id);
                renderAdminTable();
                renderPublicBlogs();
                showToast('Blog post deleted successfully.');
            }
        }

        // Initial render on load
        window.onload = function() {
            renderPublicBlogs();
        };
    </script>
</body>
</html>